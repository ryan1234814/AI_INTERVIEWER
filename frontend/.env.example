# =============================================================================
# Frontend environment (Vite — only VITE_* vars are exposed to the browser)
# =============================================================================
# LOCAL DEV: you normally do NOT need these. Leave them unset and the Vite dev
# proxy in vite.config.ts forwards /api/v1 and /ws to http://localhost:8000.
#
# VERCEL (production): set these in the Vercel dashboard (Project → Env
# Variables) to point the SPA at your Render backend. Vercel cannot proxy
# WebSockets, so the app must connect directly to the Render host.

# Absolute Render backend URL, no trailing slash.
VITE_API_URL=https://<your-render-service>.onrender.com

# WebSocket backend origin (same host, ws:// or wss:// scheme).
# If only VITE_API_URL is set, the WS URL is derived from it automatically.
VITE_WS_URL=wss://<your-render-service>.onrender.com

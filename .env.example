# =============================================================================
# Agentic AI Voice Interview Platform — Environment Configuration
# =============================================================================
# Copy this file to .env in both the project root and backend/ directory:
#   cp .env.example .env
#   cp .env.example backend/.env
#
# Then fill in your actual API keys and secrets.
# =============================================================================

# ─── Required ────────────────────────────────────────────────────────────────
# Generate a high-entropy secret key (never use a placeholder in production!):
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY="replace-with-a-generated-secret-key"

# ─── API Keys (optional — features without keys use graceful fallbacks) ──────
# Groq API key for Whisper transcription and LLM inference
# https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key"

# Deepgram API key for speech-to-text (alternative to Groq Whisper)
# https://console.deepgram.com/
DEEPGRAM_API_KEY="your_deepgram_api_key"

# NVIDIA API key (optional, for NVIDIA NIM inference)
# https://build.nvidia.com/
NVIDIA_API_KEY="your_nvidia_api_key"

# Alibaba DashScope API key (optional, for Qwen TTS)
# https://dashscope.aliyun.com/
DASHSCOPE_API_KEY="your_dashscope_api_key"

# ─── Model selection ─────────────────────────────────────────────────────────
# Groq retires model names periodically. These are configurable so a retirement
# is fixed by editing .env rather than the code. Check what your key can use at
# https://api.groq.com/openai/v1/models (Authorization: Bearer $GROQ_API_KEY).
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"
GROQ_STT_MODEL="whisper-large-v3"

# ─── Interview pacing ────────────────────────────────────────────────────────
# Max probing follow-up questions asked per interview question before the
# interview advances to the next one. Keeps the flow from circling back.
MAX_FOLLOW_UPS_PER_QUESTION=1

# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite stored in the backend directory
DATABASE_URL=sqlite:///./interview_platform.db

# ChromaDB persistent storage path (used for RAG / knowledge retrieval)
CHROMA_PATH=./chroma_db

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to access the API.
# In production, replace with your deployed frontend URL(s):
#   BACKEND_CORS_ORIGINS=https://your-app.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# SECRET_KEY (above) signs the access tokens; ALGORITHM must match the app's
# HS256 assumption. Tokens expire after ACCESS_TOKEN_EXPIRE_MINUTES.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Brute-force protection for /auth/signup and /auth/login: max attempts per
# minute, per IP (signup) and per IP+email (failed logins).
AUTH_RATE_LIMIT_PER_MINUTE=10

# Prompt budgets — keep Groq prompts inside the free-tier tokens/min limit
LLM_JOB_CONTEXT_CHARS=1200
LLM_HISTORY_TURNS=4
